<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <GenerateAssemblyInfo>True</GenerateAssemblyInfo>
  </PropertyGroup>
  <PropertyGroup>
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
  </PropertyGroup>
  <PropertyGroup>
    <SignAssembly>true</SignAssembly>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Public key only: reference assemblies need the Digi21 identity, not a real signature. -->
    <AssemblyOriginatorKeyFile>..\Digi21.PublicKey.snk</AssemblyOriginatorKeyFile>
    <PublicSign>true</PublicSign>
    <AssemblyTitle>Digi21.DigiNG.IO.Bin</AssemblyTitle>
    <Description>This package contains runtime assemblies for reading/creating Digi3D.AI binary files (*.BIN) on computers with Digi3D.AI installed.

A Digi3D.AI license is required to run applications that use the assemblies published by this package. Rent a license at https://www.digi21.net/Tienda/Alquiler or buy a license at https://www.digi21.net/Tienda/Compra  </Description>
    <Company>Dreaming With Objects S.L.</Company>
    <Product>Digi3D.AI</Product>
    <Copyright>(c) 2000-2026 Dreaming With Objects S.L.</Copyright>
    <AssemblyVersion>26.0.0.0</AssemblyVersion>
    <FileVersion>26.0.0.0</FileVersion>
    <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
    <Title>$(AssemblyName)</Title>
    <Version>26.0.0</Version>
    <Authors>José Ángel Martínez Torres</Authors>
    <PackageProjectUrl>https://digi3d.net/</PackageProjectUrl>
    <PackageIcon>IconoDigi21.png</PackageIcon>
    <RepositoryUrl>https://github.com/digi21/Digi21.DigiNG.IO.Bin.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>Digi3D Digi3D.AI Digi21 Digi DigiNG BIN</PackageTags>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <NoWarn>1701;1702;67</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <NoWarn>1701;1702;67</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Digi21.DigiNG" Version="26.0.0" ExcludeAssets="contentFiles" />
  </ItemGroup>
  <ItemGroup>
    <None Update="IconoDigi21.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
</Project>